# Library Sets
create_library_set -name fast_lib -timing { \
  /tech/cadence/gpdk45/gsclib045_all_v4.4/gsclib045/timing/fast_vdd1v2_basicCells.lib \
  /tech/cadence/gpdk45/gsclib045_all_v4.4/gsclib045/timing/fast_vdd1v2_extvdd1v2.lib \
  /tech/cadence/gpdk45/gsclib045_all_v4.4/gsclib045/timing/fast_vdd1v2_multibitsDFF.lib \
  /tech/cadence/gpdk45/gsclib045_all_v4.4/gsclib045/timing/fast_vdd1v2_extvdd1v0.lib \
}

# RC Corner
create_rc_corner -name rc_typ -T 25

# Delay Corner
create_delay_corner -name dc_fast -library_set fast_lib -rc_corner rc_typ

# Constraint Mode
create_constraint_mode -name my_constraints -sdc_files { ../synthesis/systolic_array_constraints.sdc }

# Analysis View
create_analysis_view -name av_fast -delay_corner dc_fast -constraint_mode my_constraints

# Set Analysis View
set_analysis_view -setup { av_fast } -hold { av_fast }
